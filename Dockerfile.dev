# Dev-only image: installs deps and generates the Prisma client at build
# time; source is bind-mounted over this at runtime so tsx watch picks up
# live edits. Not meant for production (see `npm run build`/`start` for that).
FROM node:20-bookworm-slim

WORKDIR /app

# openssl is required by Prisma's query engine on Debian-based images
RUN apt-get update && apt-get install -y --no-install-recommends openssl \
    && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npx prisma generate

EXPOSE 3000

CMD ["npm", "run", "dev"]
